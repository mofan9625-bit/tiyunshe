# ==============================================================================
# 梯云社 (tiyunclub.com) Nginx 站点配置参考（零死循环、高兼容规范配置）
# ==============================================================================

server {
    listen 80;
    listen 443 ssl http2;
    server_name tiyunclub.com www.tiyunclub.com;
    root /www/wwwroot/tiyunclub.com;
    index index.html;

    # 历史收录路径只做单向永久跳转，目标为可直接抓取完整正文的静态文章页。
    location = /posts/dalaocloud-audit-2026 { return 301 /posts/dalaoyun-audit-2026/; }
    location = /posts/liuliancloud-audit-2026 { return 301 /posts/liulianyun-audit-2026/; }
    location ~ ^/docs/posts/(yunjiexian|dalaoyun|huanqiuti|liulianyun|shandianshu|shenxing)-audit-2026(?:\.html)?/?$ {
        return 301 /posts/$1-audit-2026/;
    }

    # --------------------------------------------------------------------------
    # 静态 Clean URL 与常规路由支持（无循环 200 直出模式）：
    # 请求 /article 或 /airport-topic 时，自动匹配对应 html 文件，
    # 杜绝内部 internal rewrite 再次命中 301 导致的死循环（ERR_TOO_MANY_REDIRECTS）
    # --------------------------------------------------------------------------
    location / {
        try_files $uri $uri.html /index.html =404;
    }

    # --------------------------------------------------------------------------
    # 静态资源长效缓存优化
    # --------------------------------------------------------------------------
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public";
    }
}
