# ==============================================================================
# 梯云社 (tiyunclub.com) Nginx 站点配置与 301 规范重定向配置参考
# ==============================================================================

server {
    listen 80;
    listen 443 ssl http2;
    server_name tiyunclub.com www.tiyunclub.com;
    root /www/wwwroot/tiyunclub.com;
    index index.html;

    # --------------------------------------------------------------------------
    # 1. 301 永久重定向：将带 .html 的历史收录 URL 永久重定向到规范 URL（完整保留 query 参数）
    # --------------------------------------------------------------------------
    location = /article.html {
        return 301 /article$is_args$args;
    }

    location = /airport-topic.html {
        return 301 /airport-topic$is_args$args;
    }

    location = /airports.html {
        return 301 /airports$is_args$args;
    }

    location = /knowledge.html {
        return 301 /knowledge$is_args$args;
    }

    location = /tools.html {
        return 301 /tools$is_args$args;
    }

    location = /disclaimer.html {
        return 301 /disclaimer$is_args$args;
    }

    location = /trial.html {
        return 301 /trial$is_args$args;
    }

    # --------------------------------------------------------------------------
    # 2. 静态 Clean URL 支持：客户端请求 /article 时，自动读取磁盘上的 article.html
    # --------------------------------------------------------------------------
    location / {
        try_files $uri $uri.html $uri/ /index.html =404;
    }

    # --------------------------------------------------------------------------
    # 3. 静态资源长效缓存优化
    # --------------------------------------------------------------------------
    location ~* \.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|woff|woff2)$ {
        expires 30d;
        access_log off;
        add_header Cache-Control "public";
    }
}
